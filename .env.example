# =====================================================================
# ENTERPRISE KNOWLEDGE NAVIGATOR (EKN) — ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env and configure the values for your environment.
# Never commit actual secret keys or credentials to version control.
#
# NOTE FOR RAILWAY DEPLOYMENT:
# In Railway, configure these variables in the Service Variables dashboard.
# PORT is dynamically assigned by Railway at runtime; DO NOT set or hardcode PORT.
# =====================================================================

# --- Application Identity & Environment ---
# In production on Railway: set ENVIRONMENT=production and DEBUG=false
APP_NAME=Enterprise Knowledge Navigator
ENVIRONMENT=development
DEBUG=true

# --- API Server & Internal Networking ---
# Streamlit connects to FastAPI via loopback inside the container.
# IMPORTANT: Do not append /api/v1 — BackendAPIClient appends the API path automatically.
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000

# --- Relational Database (MySQL / Development SQLite Fallback) ---
# Local SQLite development fallback: sqlite:///./data/ekn.db
# Railway MySQL provisioned reference: ${{MySQL.MYSQL_URL}} or ${{DATABASE_URL}}
# Supported URL formats: mysql://, mysql+pymysql://, mysql+mysqldb:// (automatically normalized)
MYSQL_URL=
DATABASE_URL=
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_CONNECT_TIMEOUT=5

# --- Storage Configuration & Persistent Volume Paths ---
# In Railway production: mount persistent volume to /app/data/storage
# When STORAGE_LOCAL_ROOT is set, sub-paths default automatically under this root.
STORAGE_LOCAL_ROOT=./data/storage
UPLOAD_DIR=./data/storage/uploads
PROCESSED_DIR=./data/storage/processed
REPORTS_DIR=./data/storage/reports
TEMP_UPLOAD_DIR=./data/storage/temp
MAX_UPLOAD_SIZE_BYTES=262144000
MAX_FILES_PER_UPLOAD=10
UPLOAD_CHUNK_SIZE_BYTES=1048576

# --- PDF Ingestion & OCR Configuration ---
OCR_ENABLED=true
OCR_MIN_TEXT_CHARS_PER_PAGE=50
TESSERACT_CMD=tesseract
WORKER_POLL_INTERVAL_SECONDS=2.0

# --- Vector Database & Embeddings ---
# For local embedded development: leave CHROMA_HOST unset (persists to CHROMA_PERSIST_DIRECTORY)
# For Railway production: CHROMA_HOST is REQUIRED (e.g., chromadb.railway.internal), CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=ekn_document_chunks
CHROMA_UPSERT_BATCH_SIZE=50
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# --- Hierarchical Chunking ---
CHUNKING_PARENT_TARGET_TOKENS=800
CHUNKING_CHILD_TARGET_TOKENS=200
CHUNKING_CHILD_OVERLAP_TOKENS=40

# --- Hybrid Retrieval & Cross-Encoder ---
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_BATCH_SIZE=32

RETRIEVAL_DENSE_TOP_K=30
RETRIEVAL_BM25_TOP_K=30
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_CANDIDATES=30
RETRIEVAL_RERANK_CANDIDATES=30
RETRIEVAL_FINAL_TOP_K=8

# --- Conversational RAG, LLM & LangGraph ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
RAG_MAX_CONTEXT_TOKENS=4000
RAG_CONVERSATION_HISTORY_LIMIT=6
RAG_EVIDENCE_RELEVANCE_THRESHOLD=0.0
RAG_MIN_EVIDENCE_COUNT=1

# --- Automated Enterprise Knowledge Dossier PDF Generator ---
APP_BASE_URL=http://localhost:8501

# --- Enterprise Security, Authentication & RBAC ---
# Production requirement: JWT_SECRET_KEY must be a random cryptographically secure string >= 32 characters
JWT_SECRET_KEY=enterprise-knowledge-navigator-jwt-secret-key-32bytes-min
JWT_ALGORITHM=HS256
JWT_ISSUER=ekn-platform
JWT_AUDIENCE=ekn-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Demonstration Mode & Demo Credentials ---
# In development/evaluation: set ENABLE_DEMO_CREDENTIALS=true for 1-click test logins
# In Railway production: set EKN_DEMO_MODE=false and ENABLE_DEMO_CREDENTIALS=false
EKN_DEMO_MODE=true
ENABLE_DEMO_CREDENTIALS=true
DEMO_WORKSPACE_ID=dc5d9139-f381-4818-ab26-c2e878997b4d
